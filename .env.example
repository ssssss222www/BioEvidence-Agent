# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real credentials.

# Optional: NCBI uses this to contact you if your scripts misbehave.
NCBI_EMAIL=your_email@example.com

# Optional: raises the rate limit from 3 to 10 requests/second.
# Phase 0 works fine without an API key (anonymous limit is enough).
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Required for Phase 2 (`python main.py llm ...`): ZhipuAI GLM API key.
# Get one at https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# GLM chat model to use, e.g. glm-4-flash / glm-4-plus / glm-4.5-flash.
# Can be overridden per call with `--model`.
GLM_MODEL=your_available_glm_model
